{
  "schemaVersion": 1,
  "packageId": "examples.signal_bloom",
  "packageVersion": "0.1.0",
  "implementationVersion": "0.1.0",
  "description": "Package fixture for the public Signal Bloom SDK example.",
  "element": {
    "id": "example.signalBloom",
    "kind": "visual",
    "bindingMode": "bind-only",
    "actions": []
  },
  "asset": {
    "id": "examples.signal_bloom",
    "label": "Signal Bloom",
    "category": "Examples",
    "layerGroup": "Artist SDK",
    "model": "signal-bloom",
    "stateModel": "deterministic point field driven by transport, local color, and generic input modulation parameters",
    "type": "example.signalBloom",
    "registryPrefix": "examples.signal_bloom",
    "description": "Public SDK example layer showing package-declared parameters, presets, and visible mapping presets.",
    "tags": ["artist-sdk", "fixture", "generative"],
    "defaults": {}
  },
  "source": {
    "strategy": "source-registration",
    "registration": "source/register_signal_bloom.cpp",
    "files": [
      "source/SignalBloomLayer.h",
      "source/SignalBloomLayer.cpp"
    ]
  },
  "capabilities": [
    "graphics.opengl",
    "transport.read",
    "parameters.dynamic-options"
  ],
  "dependencies": [
    {
      "id": "synaptome.element-sdk",
      "kind": "static-library",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.element-sdk"
    },
    {
      "id": "synaptome.runtime",
      "kind": "runtime-service",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.runtime"
    }
  ],
  "parameterGroups": [
    { "id": "example", "label": "Example", "description": "" },
    { "id": "exampleMotion", "label": "Example Motion", "description": "" },
    { "id": "exampleTransform", "label": "Example Transform", "description": "" },
    { "id": "exampleColor", "label": "Example Color", "description": "" },
    { "id": "exampleModulation", "label": "Example Modulation", "description": "" }
  ],
  "parameters": [
    {
      "id": "visible",
      "kind": "bool",
      "groupId": "example",
      "label": "Visible",
      "default": true,
      "visible": true,
      "description": "Whether the layer contributes to the current slot."
    },
    {
      "id": "speed",
      "kind": "float",
      "groupId": "exampleMotion",
      "label": "Speed",
      "default": 0.65,
      "visible": true,
      "range": { "min": 0.0, "max": 4.0, "step": 0.01 },
      "units": "multiplier",
      "description": "Local signal motion speed."
    },
    {
      "id": "bpmSync",
      "kind": "bool",
      "groupId": "exampleMotion",
      "label": "BPM Sync",
      "default": true,
      "visible": true,
      "description": "Whether local motion follows the global transport BPM."
    },
    {
      "id": "bpmMultiplier",
      "kind": "float",
      "groupId": "exampleMotion",
      "label": "BPM Multiplier",
      "default": 1.0,
      "visible": true,
      "range": { "min": 0.25, "max": 8.0, "step": 0.25 },
      "units": "multiplier",
      "optionsSource": {
        "id": "transport.bpmMultipliers",
        "value": "multiplier",
        "label": "label"
      },
      "description": "Multiplier applied to global transport BPM when sync is enabled. Browser inspection resolves the app-owned provider to labeled multiplier choices."
    },
    {
      "id": "scale",
      "kind": "float",
      "groupId": "exampleTransform",
      "label": "Size",
      "default": 0.82,
      "visible": true,
      "range": { "min": 0.1, "max": 2.0, "step": 0.01 },
      "units": "multiplier",
      "options": [
        { "value": 0.5, "label": "Compact", "description": "Reduce the layer footprint." },
        { "value": 0.82, "label": "Default", "description": "Use the reviewed package scale." },
        { "value": 1.0, "label": "Full", "description": "Use the full normalized layer scale." }
      ],
      "description": "Layer-local visual scale."
    },
    {
      "id": "rotationDeg",
      "kind": "float",
      "groupId": "exampleTransform",
      "label": "Rotation",
      "default": 0.0,
      "visible": true,
      "range": { "min": -180.0, "max": 180.0, "step": 1.0 },
      "units": "deg",
      "description": "Layer-local rotation in degrees."
    },
    {
      "id": "alpha",
      "kind": "float",
      "groupId": "exampleColor",
      "label": "Alpha",
      "default": 0.86,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Legacy layer-local alpha exposed by the current SDK example.",
      "deprecated": {
        "replacement": "opacity",
        "reason": "New layers should prefer opacity/visibility naming, but this fixture preserves the current public SDK parameter."
      }
    },
    {
      "id": "gain",
      "kind": "float",
      "groupId": "exampleModulation",
      "label": "Sensor Gain",
      "default": 0.62,
      "visible": true,
      "range": { "min": 0.0, "max": 2.0, "step": 0.01 },
      "units": "multiplier",
      "description": "Gain applied to generic input modulation."
    },
    {
      "id": "lineOpacity",
      "kind": "float",
      "groupId": "exampleColor",
      "label": "Line Opacity",
      "default": 0.72,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Opacity for the signal line stroke."
    },
    {
      "id": "colorR",
      "kind": "float",
      "groupId": "exampleColor",
      "label": "Red",
      "default": 0.12,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Primary color red channel."
    },
    {
      "id": "colorG",
      "kind": "float",
      "groupId": "exampleColor",
      "label": "Green",
      "default": 0.78,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Primary color green channel."
    },
    {
      "id": "colorB",
      "kind": "float",
      "groupId": "exampleColor",
      "label": "Blue",
      "default": 1.0,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Primary color blue channel."
    },
    {
      "id": "bgColorR",
      "kind": "float",
      "groupId": "exampleColor",
      "label": "Background Red",
      "default": 0.02,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Background color red channel."
    },
    {
      "id": "bgColorG",
      "kind": "float",
      "groupId": "exampleColor",
      "label": "Background Green",
      "default": 0.04,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Background color green channel."
    },
    {
      "id": "bgColorB",
      "kind": "float",
      "groupId": "exampleColor",
      "label": "Background Blue",
      "default": 0.08,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Background color blue channel."
    },
    {
      "id": "xInput",
      "kind": "float",
      "groupId": "exampleModulation",
      "label": "X",
      "default": 0.5,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.001 },
      "description": "Generic horizontal modulation input."
    },
    {
      "id": "yInput",
      "kind": "float",
      "groupId": "exampleModulation",
      "label": "Y",
      "default": 0.5,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.001 },
      "description": "Generic vertical modulation input."
    },
    {
      "id": "speedInput",
      "kind": "float",
      "groupId": "exampleModulation",
      "label": "Speed",
      "default": 0.0,
      "visible": true,
      "range": { "min": 0.0, "max": 1.0, "step": 0.001 },
      "description": "Generic motion modulation input."
    }
  ],
  "presets": [
    {
      "presetId": "default",
      "label": "Default",
      "path": "presets/default.json",
      "description": "Baseline Signal Bloom settings."
    },
    {
      "presetId": "bright",
      "label": "Bright",
      "path": "presets/bright.json",
      "description": "Brighter high-energy color and line settings."
    },
    {
      "presetId": "calm",
      "label": "Calm",
      "path": "presets/calm.json",
      "description": "Softer slower settings for calmer passages."
    }
  ],
  "presetBanks": [
    {
      "id": "performance",
      "label": "Performance",
      "presets": ["default", "bright", "calm"]
    }
  ],
  "mappingPresets": [
    {
      "id": "hostMicMotion",
      "label": "Host Mic Motion",
      "description": "Visible OSC defaults that map host mic level into generic Signal Bloom controls.",
      "applyMode": "suggestion-only",
      "mappings": [
        {
          "target": "gain",
          "source": {
            "kind": "osc",
            "pattern": "/sensor/host/localmic/mic-level",
            "in": [0.0, 0.12],
            "out": [0.0, 1.6],
            "smooth": 0.25,
            "deadband": 0.01,
            "blend": "scale",
            "relative": true
          }
        },
        {
          "target": "speedInput",
          "source": {
            "kind": "osc",
            "pattern": "/sensor/host/localmic/mic-bass",
            "in": [0.0, 0.18],
            "out": [0.0, 1.0],
            "smooth": 0.18,
            "deadband": 0.01,
            "blend": "set",
            "relative": false
          }
        }
      ]
    }
  ],
  "media": [],
  "tests": {
    "confidenceProfile": "tests/layer_test.json",
    "fixtures": []
  },
  "aliases": [],
  "deprecations": [],
  "migrations": [],
  "compatibility": {
    "sdk": {
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0"
    },
    "runtime": {
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0"
    }
  }
}
