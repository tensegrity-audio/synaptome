{
  "schemaVersion": 1,
  "templateId": "templates.model.stl",
  "description": "Draft template for STL files that should become generated model-layer catalog entries.",
  "content": {
    "kind": "stl",
    "glob": "*.stl",
    "sidecarSuffix": ".generated_layer.json"
  },
  "asset": {
    "idPattern": "examples.generated_models.{contentSlug}",
    "labelPattern": "{contentTitle}",
    "category": "Generated",
    "layerGroup": "Models",
    "model": "stl-file",
    "stateModel": "static mesh content rendered by a reusable model viewer layer",
    "type": "model.stlViewer",
    "registryPrefixPattern": "examples.generated_models.{contentSlug}",
    "descriptionPattern": "Generated model layer for {contentFile}.",
    "tags": ["generated", "stl", "model"]
  },
  "source": {
    "strategy": "template-generated",
    "implementationType": "model.stlViewer"
  },
  "parameters": [
    {
      "id": "visible",
      "kind": "bool",
      "label": "Visibility: Visible",
      "default": true,
      "description": "Whether the generated model layer draws."
    },
    {
      "id": "opacity",
      "kind": "float",
      "label": "Visibility: Opacity",
      "default": 1.0,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "units": "normalized",
      "description": "Overall model opacity."
    },
    {
      "id": "scale",
      "kind": "float",
      "label": "Transform: Scale",
      "default": 1.0,
      "range": { "min": 0.001, "max": 100.0, "step": 0.001 },
      "units": "multiplier",
      "description": "Uniform mesh scale."
    },
    {
      "id": "positionX",
      "kind": "float",
      "label": "Transform: Position X",
      "default": 0.0,
      "range": { "min": -10000.0, "max": 10000.0, "step": 1.0 },
      "units": "world",
      "description": "Model offset on the X axis."
    },
    {
      "id": "positionY",
      "kind": "float",
      "label": "Transform: Position Y",
      "default": 0.0,
      "range": { "min": -10000.0, "max": 10000.0, "step": 1.0 },
      "units": "world",
      "description": "Model offset on the Y axis."
    },
    {
      "id": "positionZ",
      "kind": "float",
      "label": "Transform: Position Z",
      "default": 0.0,
      "range": { "min": -10000.0, "max": 10000.0, "step": 1.0 },
      "units": "world",
      "description": "Model offset on the Z axis."
    },
    {
      "id": "rotationXDeg",
      "kind": "float",
      "label": "Transform: Rotation X",
      "default": 0.0,
      "range": { "min": -180.0, "max": 180.0, "step": 1.0 },
      "units": "deg",
      "description": "Model rotation around the X axis."
    },
    {
      "id": "rotationYDeg",
      "kind": "float",
      "label": "Transform: Rotation Y",
      "default": 0.0,
      "range": { "min": -180.0, "max": 180.0, "step": 1.0 },
      "units": "deg",
      "description": "Model rotation around the Y axis."
    },
    {
      "id": "rotationZDeg",
      "kind": "float",
      "label": "Transform: Rotation Z",
      "default": 0.0,
      "range": { "min": -180.0, "max": 180.0, "step": 1.0 },
      "units": "deg",
      "description": "Model rotation around the Z axis."
    },
    {
      "id": "colorR",
      "kind": "float",
      "label": "Material: Red",
      "default": 0.82,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Material red channel."
    },
    {
      "id": "colorG",
      "kind": "float",
      "label": "Material: Green",
      "default": 0.86,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Material green channel."
    },
    {
      "id": "colorB",
      "kind": "float",
      "label": "Material: Blue",
      "default": 1.0,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "description": "Material blue channel."
    },
    {
      "id": "materialMode",
      "kind": "string",
      "label": "Material: Mode",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "wire", "label": "Wireframe" },
        { "value": "points", "label": "Points" }
      ],
      "description": "Named render mode for Browser option metadata validation."
    },
    {
      "id": "materialPreset",
      "kind": "string",
      "label": "Material: Preset",
      "default": "neutral",
      "optionsSource": {
        "id": "runtime.modelMaterialPresets",
        "value": "id",
        "label": "label"
      },
      "description": "Draft runtime-owned material preset provider metadata; this fixture does not resolve provider values yet."
    },
    {
      "id": "wireframe",
      "kind": "bool",
      "label": "Material: Wireframe",
      "default": false,
      "description": "Render the model as wireframe."
    },
    {
      "id": "lighting",
      "kind": "bool",
      "label": "Material: Lighting",
      "default": true,
      "description": "Apply scene lighting to the model."
    },
    {
      "id": "showNormals",
      "kind": "bool",
      "label": "Material: Show Normals",
      "default": false,
      "description": "Show normal debug lines when supported."
    },
    {
      "id": "autoCenter",
      "kind": "bool",
      "label": "Transform: Auto Center",
      "default": true,
      "description": "Center the imported mesh bounds around the layer origin."
    },
    {
      "id": "spinSpeedDeg",
      "kind": "float",
      "label": "Motion: Spin Speed",
      "default": 0.0,
      "range": { "min": -360.0, "max": 360.0, "step": 1.0 },
      "units": "deg/s",
      "description": "Automatic rotation speed around the vertical axis."
    }
  ],
  "compatibility": {
    "manifestInspectionOnly": true,
    "runtimeLoadingImplemented": false
  }
}
