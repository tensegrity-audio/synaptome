{
  "schemaVersion": 1,
  "templateId": "templates.model.stl",
  "description": "Draft template for STL files that should become generated model-layer catalog entries.",
  "content": {
    "kind": "stl",
    "glob": "*.stl",
    "sidecarSuffix": ".generated_layer.json"
  },
  "asset": {
    "idPattern": "examples.generated_models.{contentSlug}",
    "labelPattern": "{contentTitle}",
    "category": "Generated",
    "layerGroup": "Models",
    "model": "stl-file",
    "stateModel": "static mesh content rendered by a reusable model viewer layer",
    "type": "stlModel",
    "registryPrefixPattern": "examples.generated_models.{contentSlug}",
    "descriptionPattern": "Generated model layer for {contentFile}.",
    "tags": ["generated", "stl", "model"]
  },
  "source": {
    "strategy": "template-generated",
    "implementationType": "stlModel"
  },
  "parameters": [
    {
      "id": "visible",
      "kind": "bool",
      "label": "Visibility: Visible",
      "default": true,
      "description": "Whether the generated model layer draws."
    },
    {
      "id": "spin",
      "kind": "float",
      "label": "Model: Spin",
      "default": 18.0,
      "range": { "min": -360.0, "max": 360.0, "step": 1.0 },
      "units": "deg/s",
      "description": "Automatic rotation speed around the vertical axis."
    },
    {
      "id": "hover",
      "kind": "float",
      "label": "Model: Hover",
      "default": 16.0,
      "range": { "min": 0.0, "max": 200.0, "step": 1.0 },
      "units": "world",
      "description": "Vertical hover amplitude."
    },
    {
      "id": "baseHeight",
      "kind": "float",
      "label": "Model: Base Height",
      "default": 140.0,
      "range": { "min": -400.0, "max": 400.0, "step": 1.0 },
      "units": "world",
      "description": "Base vertical placement."
    },
    {
      "id": "orbitRadius",
      "kind": "float",
      "label": "Model: Orbit Radius",
      "default": 0.0,
      "range": { "min": 0.0, "max": 600.0, "step": 1.0 },
      "units": "world",
      "description": "Horizontal orbit radius."
    },
    {
      "id": "orbitSpeed",
      "kind": "float",
      "label": "Model: Orbit Speed",
      "default": 0.0,
      "range": { "min": -360.0, "max": 360.0, "step": 1.0 },
      "units": "deg/s",
      "description": "Horizontal orbit speed."
    },
    {
      "id": "rotateX",
      "kind": "float",
      "label": "Model: Rotate X",
      "default": 0.0,
      "range": { "min": -180.0, "max": 180.0, "step": 1.0 },
      "units": "deg",
      "description": "Model rotation around the X axis."
    },
    {
      "id": "rotateY",
      "kind": "float",
      "label": "Model: Rotate Y",
      "default": 0.0,
      "range": { "min": -180.0, "max": 180.0, "step": 1.0 },
      "units": "deg",
      "description": "Model rotation around the Y axis."
    },
    {
      "id": "rotateZ",
      "kind": "float",
      "label": "Model: Rotate Z",
      "default": 0.0,
      "range": { "min": -180.0, "max": 180.0, "step": 1.0 },
      "units": "deg",
      "description": "Model rotation around the Z axis."
    },
    {
      "id": "colorR",
      "kind": "float",
      "label": "Material: Red",
      "default": 255.0,
      "range": { "min": 0.0, "max": 255.0, "step": 1.0 },
      "description": "Material red channel."
    },
    {
      "id": "colorG",
      "kind": "float",
      "label": "Material: Green",
      "default": 140.0,
      "range": { "min": 0.0, "max": 255.0, "step": 1.0 },
      "description": "Material green channel."
    },
    {
      "id": "colorB",
      "kind": "float",
      "label": "Material: Blue",
      "default": 0.0,
      "range": { "min": 0.0, "max": 255.0, "step": 1.0 },
      "description": "Material blue channel."
    },
    {
      "id": "scale",
      "kind": "float",
      "label": "Model: Scale",
      "default": 180.0,
      "range": { "min": 20.0, "max": 500.0, "step": 1.0 },
      "units": "world",
      "description": "Uniform mesh scale."
    },
    {
      "id": "lineOpacity",
      "kind": "float",
      "label": "Model: Line Opacity",
      "default": 1.0,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "units": "normalized",
      "description": "Wireframe line opacity."
    },
    {
      "id": "faceOpacity",
      "kind": "float",
      "label": "Model: Face Opacity",
      "default": 0.18,
      "range": { "min": 0.0, "max": 1.0, "step": 0.01 },
      "units": "normalized",
      "description": "Filled-face opacity."
    }
  ],
  "compatibility": {
    "manifestInspectionOnly": false,
    "runtimeLoadingImplemented": true
  }
}
