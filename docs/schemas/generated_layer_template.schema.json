{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Synaptome Generated Layer Template",
  "description": "Draft schema for file-backed generated layer templates such as STL model drops.",
  "type": "object",
  "required": ["schemaVersion", "templateId", "content", "asset", "parameters"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "templateId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][A-Za-z0-9_.-]*$"
    },
    "description": { "type": "string" },
    "content": { "$ref": "#/definitions/content" },
    "asset": { "$ref": "#/definitions/asset" },
    "source": { "$ref": "#/definitions/source" },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/definitions/parameter" }
    },
    "compatibility": { "$ref": "#/definitions/compatibility" }
  },
  "definitions": {
    "content": {
      "type": "object",
      "required": ["kind", "glob"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["stl"] },
        "glob": { "type": "string", "minLength": 1 },
        "root": { "type": "string" },
        "sidecarSuffix": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "required": ["idPattern", "labelPattern", "category", "layerGroup", "type", "registryPrefixPattern"],
      "additionalProperties": false,
      "properties": {
        "idPattern": { "type": "string", "minLength": 1 },
        "labelPattern": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "layerGroup": { "type": "string" },
        "model": { "type": "string" },
        "stateModel": { "type": "string" },
        "type": { "type": "string", "minLength": 1 },
        "registryPrefixPattern": { "type": "string", "minLength": 1 },
        "descriptionPattern": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "type": "string", "enum": ["template-generated"] },
        "implementationType": { "type": "string", "minLength": 1 }
      }
    },
    "range": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" }
      }
    },
    "option": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string" },
            { "type": "boolean" }
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "optionsSource": {
      "type": "object",
      "required": ["id", "value", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["id", "kind", "label", "default"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "kind": { "type": "string", "enum": ["float", "bool", "string"] },
        "label": { "type": "string", "minLength": 1 },
        "default": {},
        "range": { "$ref": "#/definitions/range" },
        "units": { "type": "string" },
        "description": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/definitions/option" }
        },
        "optionsSource": { "$ref": "#/definitions/optionsSource" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifestInspectionOnly": { "type": "boolean" },
        "runtimeLoadingImplemented": { "type": "boolean" }
      }
    }
  }
}
