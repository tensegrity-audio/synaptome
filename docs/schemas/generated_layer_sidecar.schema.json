{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Synaptome Generated Layer Sidecar",
  "description": "Draft optional metadata sidecar for one file-backed generated layer content item.",
  "type": "object",
  "required": ["schemaVersion", "templateId", "contentFile"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "templateId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][A-Za-z0-9_.-]*$"
    },
    "contentFile": { "type": "string", "minLength": 1 },
    "contentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][A-Za-z0-9]*(?:[._:-][A-Za-z0-9]+)*$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "physicalScale": { "type": "number", "exclusiveMinimum": 0 },
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "number" },
          { "type": "string" },
          { "type": "boolean" }
        ]
      }
    }
  }
}
