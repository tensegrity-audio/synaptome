{
  "name": "Adaptive Trail family",
  "stages": {
    "fast": [
      {
        "label": "agentField source, defaults, identity, and deterministic seed contract",
        "command": [
          "{python}",
          "tools/validate_modular_layer_families.py",
          "--family",
          "agentField"
        ]
      }
    ],
    "native": [],
    "incrementalApp": [
      {
        "label": "incremental Synaptome app build",
        "command": [
          "{msbuild}",
          "synaptome/Synaptome.vcxproj",
          "/p:Configuration=Release",
          "/p:Platform=x64",
          "/p:BuildProjectReferences=false",
          "/m",
          "/v:minimal"
        ]
      }
    ]
  }
}
