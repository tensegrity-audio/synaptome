{
  "name": "Collective Motion family",
  "stages": {
    "fast": [
      {
        "label": "flocking source, defaults, identity, and deterministic seed contract",
        "command": [
          "{python}",
          "tools/validate_modular_layer_families.py",
          "--family",
          "flocking"
        ]
      }
    ],
    "native": [],
    "incrementalApp": [
      {
        "label": "incremental Synaptome app build",
        "command": [
          "{msbuild}",
          "synaptome/Synaptome.vcxproj",
          "/p:Configuration=Release",
          "/p:Platform=x64",
          "/m",
          "/v:minimal"
        ]
      }
    ]
  }
}
