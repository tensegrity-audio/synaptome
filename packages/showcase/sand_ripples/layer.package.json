{
  "schemaVersion": 1,
  "packageId": "show.sand_ripples",
  "packageVersion": "0.1.0",
  "implementationVersion": "0.1.0",
  "description": "Sand Ripples: migrating dunes with coherent ridges and faceted low-poly relief.",
  "element": {
    "id": "show.sandRipples",
    "kind": "visual",
    "bindingMode": "bind-only",
    "actions": []
  },
  "asset": {
    "id": "show.sand_ripples",
    "label": "Sand Ripples",
    "category": "Generative",
    "layerGroup": "Planetary Fields",
    "model": "conservative-saltation-repose",
    "stateModel": "A 64 by 40 periodic height field transports sand downwind and relaxes slopes above the repose threshold.",
    "type": "show.sandRipples",
    "registryPrefix": "show.sand_ripples",
    "description": "Migrating dunes with coherent ridges and faceted low-poly relief.",
    "tags": [
      "generative",
      "showcase",
      "deterministic",
      "simulation"
    ],
    "defaults": {}
  },
  "source": {
    "strategy": "source-registration",
    "registration": "source/register_sand_ripples.cpp",
    "files": [
      "source/SandRipplesModel.h",
      "source/SandRipplesLayer.h",
      "source/SandRipplesLayer.cpp"
    ]
  },
  "capabilities": [
    "graphics.opengl",
    "transport.read",
    "parameters.dynamic-options"
  ],
  "dependencies": [
    {
      "id": "synaptome.element-sdk",
      "kind": "static-library",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.element-sdk"
    },
    {
      "id": "synaptome.runtime",
      "kind": "runtime-service",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.runtime"
    }
  ],
  "parameterGroups": [
