      "label": "Motion: Rotation",
      "default": 0,
      "visible": true,
      "description": "Rotation.",
      "range": {
        "min": -180,
        "max": 180,
        "step": 1
      },
      "units": "deg"
    },
    {
      "id": "transportRate",
      "kind": "float",
      "groupId": "time",
      "label": "Time: Sand Transport",
      "default": 1,
      "visible": true,
      "description": "Rate of conservative erosion and downwind deposition.",
      "range": {
        "min": 0,
        "max": 4,
        "step": 0.01
      },
      "units": "multiplier",
      "quickAccessOrder": 1
    },
    {
      "id": "windDirectionDeg",
      "kind": "float",
      "groupId": "motion",
      "label": "Motion: Wind Direction",
