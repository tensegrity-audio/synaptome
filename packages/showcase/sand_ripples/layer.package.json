        "step": 0.01
      }
    },
    {
      "id": "accentR",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Accent Red",
      "default": 1,
      "visible": true,
      "description": "Accent Red.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "accentG",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Accent Green",
      "default": 0.86,
      "visible": true,
      "description": "Accent Green.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "accentB",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Accent Blue",
