  "parameters": [
    {
      "id": "speed",
      "kind": "float",
      "groupId": "motion",
      "label": "Motion: Speed",
      "default": 0.8,
      "visible": true,
      "description": "Local simulation rate; zero pauses. Multiplied by the global transport speed.",
      "range": {
        "min": 0,
        "max": 3,
        "step": 0.01
      },
      "units": "multiplier",
      "quickAccessOrder": 0
    },
    {
      "id": "bpmSync",
      "kind": "bool",
      "groupId": "time",
      "label": "Time: BPM Sync",
      "default": true,
      "visible": true,
      "description": "Scale simulation time by global BPM relative to 120 BPM."
    },
    {
      "id": "bpmMultiplier",
      "kind": "float",
      "groupId": "time",
      "label": "Time: BPM Multiplier",
      "default": 1,
      "visible": true,
      "description": "BPM Multiplier.",
      "range": {
        "min": 0.25,
        "max": 4,
        "step": 0.25
      },
      "units": "multiplier",
      "optionsSource": {
