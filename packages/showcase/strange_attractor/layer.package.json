      "id": "performance",
      "label": "Performance",
      "presets": [
        "default",
        "calm",
        "energized"
      ]
    }
  ],
  "mappingPresets": [
    {
      "id": "hostMic",
      "label": "Host Mic",
      "description": "Optional visible model-control routes. Shared host-mic profiles scale the current base by 0.65 to 1.65; preview conflicts before applying. Silent input retains motion.",
      "applyMode": "suggestion-only",
      "mappings": [
        {
          "target": {
            "kind": "parameter",
            "id": "rho"
          },
          "source": {
            "kind": "osc",
            "pattern": "/sensor/host/localmic/mic-bass",
            "in": [
              0.0,
              0.18
            ],
            "out": [
              0.65,
              1.65
            ],
            "smooth": 0.2,
            "deadband": 0.01,
            "blend": "scale",
            "relative": true
          }
        },
        {
          "target": {
            "kind": "parameter",
            "id": "ribbonWidth"
          },
          "source": {
            "kind": "osc",
            "pattern": "/sensor/host/localmic/mic-level",
            "in": [
              0.0,
              0.12
            ],
            "out": [
              0.65,
              1.65
            ],
            "smooth": 0.2,
            "deadband": 0.01,
            "blend": "scale",
            "relative": true
          }
        }
      ]
    }
  ],
