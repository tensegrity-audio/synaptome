{
  "schemaVersion": 1,
  "packageId": "show.strange_attractor",
  "packageVersion": "0.1.0",
  "implementationVersion": "0.1.0",
  "description": "Four nearby Lorenz trajectories separate into luminous folded ribbons. Color follows trajectory speed, depth and history age.",
  "element": {
    "id": "show.strangeAttractor",
    "kind": "visual",
    "bindingMode": "bind-only",
    "actions": []
  },
  "asset": {
    "id": "show.strange_attractor",
    "label": "Strange Attractor",
    "category": "Generative",
    "layerGroup": "Dynamical Systems",
    "model": "lorenz-rk4",
    "stateModel": "four bounded RK4 Lorenz trajectories with fixed circular histories and explicit projected ribbon rendering",
    "type": "show.strangeAttractor",
    "registryPrefix": "show.strange_attractor",
    "description": "Four nearby Lorenz trajectories separate into luminous folded ribbons. Color follows trajectory speed, depth and history age.",
    "tags": [
      "algorithmic",
      "showcase",
      "chaotic-dynamics"
    ],
    "defaults": {}
  },
  "source": {
    "strategy": "source-registration",
    "registration": "source/register_strange_attractor.cpp",
    "files": [
      "source/StrangeAttractorLayer.h",
      "source/StrangeAttractorLayer.cpp",
      "source/StrangeAttractorModel.h",
      "source/Projection.h"
    ]
  },
  "capabilities": [
    "graphics.opengl",
    "transport.read",
    "parameters.dynamic-options"
  ],
  "dependencies": [
    {
      "id": "synaptome.element-sdk",
      "kind": "static-library",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.element-sdk"
    },
    {
      "id": "synaptome.runtime",
      "kind": "runtime-service",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.runtime"
    }
  ],
  "parameterGroups": [
