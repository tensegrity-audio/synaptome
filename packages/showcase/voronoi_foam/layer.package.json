{
  "schemaVersion": 1,
  "packageId": "show.voronoi_foam",
  "packageVersion": "0.1.0",
  "implementationVersion": "0.1.0",
  "description": "Voronoi Foam: breathing cell walls, shifting membranes, and softly filled crystalline tissue.",
  "element": {
    "id": "show.voronoiFoam",
    "kind": "visual",
    "bindingMode": "bind-only",
    "actions": []
  },
  "asset": {
    "id": "show.voronoi_foam",
    "label": "Voronoi Foam",
    "category": "Generative",
    "layerGroup": "Cellular Fields",
    "model": "moving-centroidal-voronoi",
    "stateModel": "32 moving periodic Voronoi sites relax toward sampled cell centroids while short-range pressure and shear deform the cells.",
    "type": "show.voronoiFoam",
    "registryPrefix": "show.voronoi_foam",
    "description": "Breathing cell walls, shifting membranes, and softly filled crystalline tissue.",
    "tags": [
      "generative",
      "showcase",
      "deterministic",
      "simulation"
    ],
    "defaults": {}
  },
  "source": {
    "strategy": "source-registration",
    "registration": "source/register_voronoi_foam.cpp",
    "files": [
      "source/VoronoiFoamModel.h",
      "source/VoronoiFoamLayer.h",
      "source/VoronoiFoamLayer.cpp"
    ]
  },
  "capabilities": [
    "graphics.opengl",
    "transport.read",
    "parameters.dynamic-options"
  ],
  "dependencies": [
    {
      "id": "synaptome.element-sdk",
      "kind": "static-library",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.element-sdk"
    },
    {
      "id": "synaptome.runtime",
      "kind": "runtime-service",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.runtime"
    }
  ],
  "parameterGroups": [
    {
      "id": "motion",
      "label": "Motion",
      "description": "Motion controls."
    },
    {
      "id": "time",
      "label": "Time",
      "description": "Time controls."
    },
    {
      "id": "scale",
      "label": "Scale",
      "description": "Scale controls."
    },
    {
      "id": "force",
      "label": "Force",
      "description": "Force controls."
    },
    {
      "id": "visibility",
      "label": "Visibility",
      "description": "Visibility controls."
    },
    {
      "id": "glow",
      "label": "Glow",
      "description": "Glow controls."
    },
    {
      "id": "color",
      "label": "Color",
      "description": "Color controls."
    },
    {
      "id": "seed",
      "label": "Seed",
      "description": "Seed controls."
    }
  ],
  "parameters": [
    {
      "id": "speed",
      "kind": "float",
      "groupId": "motion",
      "label": "Motion: Speed",
      "default": 0.8,
      "visible": true,
      "description": "Local simulation rate; zero pauses. Multiplied by the global transport speed.",
      "range": {
        "min": 0,
        "max": 3,
        "step": 0.01
      },
      "units": "multiplier",
      "quickAccessOrder": 0
    },
    {
      "id": "bpmSync",
      "kind": "bool",
      "groupId": "time",
      "label": "Time: BPM Sync",
      "default": true,
      "visible": true,
      "description": "Scale simulation time by global BPM relative to 120 BPM."
    },
    {
      "id": "bpmMultiplier",
      "kind": "float",
      "groupId": "time",
      "label": "Time: BPM Multiplier",
      "default": 1,
      "visible": true,
      "description": "BPM Multiplier.",
      "range": {
        "min": 0.25,
        "max": 4,
        "step": 0.25
      },
      "units": "multiplier",
      "optionsSource": {
        "id": "transport.bpmMultipliers",
        "value": "multiplier",
        "label": "label"
      }
    },
    {
      "id": "scale",
      "kind": "float",
      "groupId": "scale",
      "label": "Scale: Size",
      "default": 0.92,
      "visible": true,
      "description": "Size.",
      "range": {
        "min": 0.25,
        "max": 2,
        "step": 0.01
      },
      "units": "multiplier"
    },
    {
      "id": "rotationDeg",
      "kind": "float",
      "groupId": "motion",
      "label": "Motion: Rotation",
      "default": 0,
      "visible": true,
      "description": "Rotation.",
      "range": {
        "min": -180,
        "max": 180,
        "step": 1
      },
      "units": "deg"
    },
    {
      "id": "driftSpeed",
      "kind": "float",
      "groupId": "motion",
      "label": "Motion: Site Drift",
      "default": 0.35,
      "visible": true,
      "description": "Multiplier on the bounded self-propelled drift of each existing site.",
      "range": {
        "min": 0,
        "max": 2,
        "step": 0.01
      },
      "units": "multiplier",
      "quickAccessOrder": 1
    },
    {
      "id": "relaxationRate",
      "kind": "float",
      "groupId": "time",
      "label": "Time: Cell Relaxation",
      "default": 0.7,
      "visible": true,
      "description": "Cell Relaxation.",
      "range": {
        "min": 0,
        "max": 3,
        "step": 0.01
      },
      "units": "perSecond",
      "quickAccessOrder": 2
    },
    {
      "id": "repulsionWeight",
      "kind": "float",
      "groupId": "force",
      "label": "Force: Cell Pressure",
      "default": 0.5,
      "visible": true,
      "description": "Cell Pressure.",
      "range": {
        "min": 0,
        "max": 2,
        "step": 0.01
      },
      "units": "multiplier",
      "quickAccessOrder": 3
    },
    {
      "id": "shear",
      "kind": "float",
      "groupId": "force",
      "label": "Force: Shear",
      "default": 0.15,
      "visible": true,
      "description": "Signed shear flow deforms existing cells without replacing sites.",
      "range": {
        "min": -1,
        "max": 1,
        "step": 0.01
      },
      "quickAccessOrder": 4
    },
    {
      "id": "wallWidth",
      "kind": "float",
      "groupId": "scale",
      "label": "Scale: Wall Width",
      "default": 0.024,
      "visible": true,
      "description": "Wall Width.",
      "range": {
        "min": 0.006,
        "max": 0.08,
        "step": 0.001
      },
      "units": "world"
    },
    {
      "id": "cellFill",
      "kind": "float",
      "groupId": "visibility",
      "label": "Visibility: Cell Interior Opacity",
      "default": 0.14,
      "visible": true,
      "description": "Opacity of cell interiors; cell walls remain visible.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      "quickAccessOrder": 5
    },
    {
      "id": "edgeRadiance",
      "kind": "float",
      "groupId": "glow",
      "label": "Glow: Wall Radiance",
      "default": 1,
      "visible": true,
      "description": "Wall Radiance.",
      "range": {
        "min": 0.2,
        "max": 3,
        "step": 0.01
      },
      "units": "multiplier"
    },
    {
      "id": "colorR",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Primary Red",
      "default": 0.15,
      "visible": true,
      "description": "Primary Red.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "colorG",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Primary Green",
      "default": 0.94,
      "visible": true,
      "description": "Primary Green.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "colorB",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Primary Blue",
      "default": 0.68,
      "visible": true,
      "description": "Primary Blue.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "accentR",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Accent Red",
      "default": 0.35,
      "visible": true,
      "description": "Accent Red.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "accentG",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Accent Green",
      "default": 0.2,
      "visible": true,
      "description": "Accent Green.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "accentB",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Accent Blue",
      "default": 1,
      "visible": true,
      "description": "Accent Blue.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "seed",
      "kind": "float",
      "groupId": "seed",
      "label": "Seed: Seed",
      "default": 1703,
      "visible": true,
      "description": "Deterministic startup identity. Changing this value explicitly resets the simulation.",
      "range": {
        "min": 0,
        "max": 65535,
        "step": 1
      }
    }
  ],
  "presets": [
    {
      "presetId": "default",
      "label": "Default",
      "path": "presets/default.json",
      "description": "Complete baseline model with immediate visible output."
    },
    {
      "presetId": "calm",
      "label": "Calm",
      "path": "presets/calm.json",
      "description": "Slower motion and restrained deformation."
    },
    {
      "presetId": "energized",
      "label": "Energized",
      "path": "presets/energized.json",
      "description": "Faster evolution and stronger model forces."
    }
  ],
  "presetBanks": [
    {
      "id": "performance",
      "label": "Performance",
      "presets": [
        "default",
        "calm",
        "energized"
      ]
    }
  ],
  "mappingPresets": [
    {
      "id": "hostMicMotion",
      "label": "Host Mic Motion",
      "description": "Optional visible model-control routes. Shared host-mic profiles scale the current base by 0.65 to 1.65; preview conflicts before applying. Silent input retains motion.",
      "applyMode": "suggestion-only",
      "mappings": [
        {
          "target": {
            "kind": "parameter",
            "id": "repulsionWeight"
          },
          "source": {
            "kind": "osc",
            "pattern": "/sensor/host/localmic/mic-bass",
            "in": [
              0.0,
              0.18
            ],
            "out": [
              0.65,
              1.65
            ],
            "smooth": 0.2,
            "deadband": 0.01,
            "blend": "scale",
            "relative": true
          }
        },
        {
          "target": {
            "kind": "parameter",
            "id": "wallWidth"
          },
          "source": {
            "kind": "osc",
            "pattern": "/sensor/host/localmic/mic-level",
            "in": [
              0.0,
              0.12
            ],
            "out": [
              0.65,
              1.65
            ],
            "smooth": 0.2,
            "deadband": 0.01,
            "blend": "scale",
            "relative": true
          }
        }
      ]
    }
  ],
  "media": [],
  "tests": {
    "confidenceProfile": "tests/layer_test.json",
    "fixtures": []
  },
  "aliases": [],
  "deprecations": [],
  "migrations": [],
  "compatibility": {
    "sdk": {
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0"
    },
    "runtime": {
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0"
    }
  }
}
