{
  "schemaVersion": 1,
  "packageId": "show.gerstner_ocean",
  "packageVersion": "0.1.0",
  "implementationVersion": "0.1.0",
  "description": "A faceted ocean driven by three deep-water Gerstner waves. Height, face normal and slope determine all facet colors.",
  "element": {
    "id": "show.gerstnerOcean",
    "kind": "visual",
    "bindingMode": "bind-only",
    "actions": []
  },
  "asset": {
    "id": "show.gerstner_ocean",
    "label": "Gerstner Ocean",
    "category": "Generative",
    "layerGroup": "Planetary And World Models",
    "model": "gerstner-wave-surface",
    "stateModel": "fixed triangulated grid sampling three dispersive trochoidal waves with bounded phase and non-folding horizontal displacement",
    "type": "show.gerstnerOcean",
    "registryPrefix": "show.gerstner_ocean",
    "description": "A faceted ocean driven by three deep-water Gerstner waves. Height, face normal and slope determine all facet colors.",
    "tags": [
      "algorithmic",
      "showcase",
      "low-poly"
    ],
    "defaults": {}
  },
  "source": {
    "strategy": "source-registration",
    "registration": "source/register_gerstner_ocean.cpp",
    "files": [
      "source/GerstnerOceanLayer.h",
      "source/GerstnerOceanLayer.cpp",
      "source/GerstnerOceanModel.h",
      "source/Projection.h"
    ]
  },
  "capabilities": [
    "graphics.opengl",
    "transport.read",
    "parameters.dynamic-options"
  ],
  "dependencies": [
    {
      "id": "synaptome.element-sdk",
      "kind": "static-library",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.element-sdk"
    },
    {
      "id": "synaptome.runtime",
      "kind": "runtime-service",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.runtime"
    }
  ],
