  "mappingPresets": [
    {
      "id": "hostMic",
      "label": "Host Mic",
      "description": "Optional visible model-control routes. Shared host-mic profiles scale the current base by 0.65 to 1.65; preview conflicts before applying. Silent input retains motion.",
      "applyMode": "suggestion-only",
      "mappings": [
        {
          "target": {
            "kind": "parameter",
            "id": "repulsion"
          },
          "source": {
            "kind": "osc",
            "pattern": "/sensor/host/localmic/mic-bass",
            "in": [
              0.0,
              0.18
            ],
            "out": [
              0.65,
              1.65
            ],
            "smooth": 0.2,
            "deadband": 0.01,
            "blend": "scale",
            "relative": true
          }
        },
        {
          "target": {
            "kind": "parameter",
            "id": "growthRate"
          },
          "source": {
            "kind": "osc",
            "pattern": "/sensor/host/localmic/mic-mids",
            "in": [
              0.0,
              0.16
            ],
            "out": [
              0.65,
              1.65
            ],
            "smooth": 0.2,
            "deadband": 0.01,
            "blend": "scale",
            "relative": true
          }
        },
        {
          "target": {
            "kind": "parameter",
            "id": "glow"
          },
          "source": {
            "kind": "osc",
            "pattern": "/sensor/host/localmic/mic-highs",
            "in": [
              0.0,
              0.1
            ],
            "out": [
              0.65,
              1.65
            ],
            "smooth": 0.2,
            "deadband": 0.01,
            "blend": "scale",
            "relative": true
          }
        }
      ]
    }
