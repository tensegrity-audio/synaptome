    {
      "id": "highlightB",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Highlight Blue",
      "default": 0.85,
      "visible": true,
      "description": "Normalized highlight blue component of the model-derived palette.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
