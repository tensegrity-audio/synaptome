      "description": "Default performance starting point."
    },
    {
      "presetId": "calm",
      "label": "Calm",
      "path": "presets/calm.json",
      "description": "Calm performance starting point."
    },
    {
      "presetId": "energized",
      "label": "Energized",
      "path": "presets/energized.json",
      "description": "Energized performance starting point."
    }
