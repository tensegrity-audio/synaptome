{
  "schemaVersion": 1,
  "packageId": "show.elastic_lattice",
  "packageVersion": "0.1.0",
  "implementationVersion": "0.1.0",
  "description": "An elastic low-poly membrane rings and folds under a travelling driver. Displacement, local strain and face normals determine its facets.",
  "element": {
    "id": "show.elasticLattice",
    "kind": "visual",
    "bindingMode": "bind-only",
    "actions": []
  },
  "asset": {
    "id": "show.elastic_lattice",
    "label": "Elastic Lattice",
    "category": "Generative",
    "layerGroup": "Dynamical Systems",
    "model": "damped-spring-membrane",
    "stateModel": "fixed mass-spring height lattice with clamped edges, anchor restoring forces, viscosity and a travelling localized periodic driver",
    "type": "show.elasticLattice",
    "registryPrefix": "show.elastic_lattice",
    "description": "An elastic low-poly membrane rings and folds under a travelling driver. Displacement, local strain and face normals determine its facets.",
    "tags": [
      "algorithmic",
      "showcase",
      "low-poly"
    ],
    "defaults": {}
  },
  "source": {
    "strategy": "source-registration",
    "registration": "source/register_elastic_lattice.cpp",
    "files": [
      "source/ElasticLatticeLayer.h",
      "source/ElasticLatticeLayer.cpp",
      "source/ElasticLatticeModel.h",
      "source/Projection.h"
    ]
  },
  "capabilities": [
    "graphics.opengl",
    "transport.read",
    "parameters.dynamic-options"
  ],
  "dependencies": [
    {
      "id": "synaptome.element-sdk",
      "kind": "static-library",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.element-sdk"
    },
    {
      "id": "synaptome.runtime",
      "kind": "runtime-service",
      "required": true,
      "versionRange": ">=0.1.0 <1.0.0",
      "resolvedVersion": "0.1.0",
      "provider": "synaptome.runtime"
    }
  ],
  "parameterGroups": [
    {
      "id": "motion",
      "label": "Motion",
      "description": ""
    },
    {
      "id": "time",
      "label": "Time",
