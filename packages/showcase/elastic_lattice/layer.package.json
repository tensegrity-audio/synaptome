      "label": "Visibility",
      "description": ""
    },
    {
      "id": "color",
      "label": "Color",
      "description": ""
    }
  ],
  "parameters": [
    {
      "id": "speed",
      "kind": "float",
      "groupId": "motion",
      "label": "Motion: Speed",
      "default": 0.65,
      "visible": true,
      "description": "Local time multiplier; zero holds current state.",
      "range": {
        "min": 0,
        "max": 4,
        "step": 0.01
      },
      "units": "multiplier",
      "quickAccessOrder": 4
    },
    {
      "id": "bpmSync",
      "kind": "bool",
      "groupId": "time",
      "label": "Time: BPM Sync",
      "default": true,
      "visible": true,
      "description": "Multiply local time by transport BPM relative to 120 BPM."
    },
    {
      "id": "bpmMultiplier",
      "kind": "float",
      "groupId": "time",
      "label": "Time: BPM Multiplier",
      "default": 1,
      "visible": true,
      "description": "Rhythmic multiplier used only when BPM sync is enabled.",
      "range": {
        "min": 0.25,
        "max": 8,
        "step": 0.25
      },
      "units": "multiplier",
      "optionsSource": {
        "id": "transport.bpmMultipliers",
        "value": "multiplier",
        "label": "label"
      }
    },
    {
      "id": "scale",
      "kind": "float",
      "groupId": "scale",
      "label": "Scale: Scene Scale",
      "default": 1,
      "visible": true,
      "description": "Uniform size of the projected model.",
      "range": {
        "min": 0.3,
        "max": 1.6,
        "step": 0.01
      },
      "units": "multiplier"
    },
    {
      "id": "yawDeg",
      "kind": "float",
      "groupId": "motion",
      "label": "Motion: View Yaw",
      "default": -24,
      "visible": true,
      "description": "Rotate the view around the vertical model axis.",
      "range": {
        "min": -180,
        "max": 180,
        "step": 1
      },
      "units": "deg"
    },
    {
      "id": "tiltDeg",
      "kind": "float",
      "groupId": "motion",
      "label": "Motion: View Elevation",
      "default": 38,
      "visible": true,
      "description": "Viewing elevation for explicit orthographic 3D projection.",
      "range": {
        "min": 10,
        "max": 75,
        "step": 1
      },
      "units": "deg"
    },
    {
      "id": "spinRate",
      "kind": "float",
      "groupId": "motion",
      "label": "Motion: View Spin",
      "default": 3,
      "visible": true,
      "description": "Continuous view rotation, respecting local and transport speed.",
      "range": {
        "min": -30,
        "max": 30,
        "step": 0.1
      },
      "units": "deg/s",
      "quickAccessOrder": 5
    },
    {
      "id": "seed",
      "kind": "float",
      "groupId": "seed",
      "label": "Seed: Seed",
      "default": 1001,
      "visible": true,
      "description": "Deterministic initial state; changing this value explicitly reseeds the model.",
      "range": {
        "min": 0,
        "max": 65535,
        "step": 1
      },
      "units": "id"
    },
    {
      "id": "reseed",
      "kind": "bool",
      "groupId": "action",
      "label": "Action: Reseed",
      "default": false,
      "visible": true,
      "description": "One-shot request to restore the current seed; resets after handling."
    },
    {
      "id": "springStiffness",
      "kind": "float",
      "groupId": "force",
      "label": "Force: Spring Stiffness",
      "default": 45,
      "visible": true,
      "description": "Nearest-neighbor spring coupling in the fixed mass lattice.",
      "range": {
        "min": 8,
        "max": 90,
        "step": 0.5
      },
      "units": "1/s2",
      "quickAccessOrder": 1
    },
    {
      "id": "restoringForce",
      "kind": "float",
      "groupId": "force",
      "label": "Force: Anchor Stiffness",
      "default": 2.5,
      "visible": true,
      "description": "Restoring force toward each node original height.",
      "range": {
        "min": 0.4,
        "max": 8,
        "step": 0.05
      },
      "units": "1/s2"
    },
    {
      "id": "dampingRate",
      "kind": "float",
      "groupId": "time",
      "label": "Time: Damping Rate",
      "default": 1.2,
      "visible": true,
      "description": "Viscous energy loss per second.",
      "range": {
        "min": 0.3,
        "max": 6,
        "step": 0.05
      },
      "units": "1/s",
      "quickAccessOrder": 2
    },
    {
      "id": "impulseStrength",
      "kind": "float",
      "groupId": "force",
      "label": "Force: Driver Strength",
      "default": 5,
      "visible": true,
      "description": "Strength of the travelling localized periodic force.",
      "range": {
        "min": 0,
        "max": 15,
        "step": 0.1
      },
      "units": "world/s2",
      "quickAccessOrder": 0
    },
    {
      "id": "impulseRate",
      "kind": "float",
      "groupId": "time",
      "label": "Time: Driver Frequency",
      "default": 0.45,
      "visible": true,
      "description": "Driver orbit frequency; the force oscillates three times per orbit.",
      "range": {
        "min": 0.1,
        "max": 2,
        "step": 0.01
      },
      "units": "Hz"
    },
    {
      "id": "heightScale",
      "kind": "float",
      "groupId": "scale",
      "label": "Scale: Height Scale",
      "default": 1,
      "visible": true,
      "description": "Rendered height multiplier; leaves stored physical state intact.",
      "range": {
        "min": 0.3,
        "max": 2,
        "step": 0.01
      },
      "units": "multiplier",
      "quickAccessOrder": 3
    },
    {
      "id": "wireOpacity",
      "kind": "float",
      "groupId": "visibility",
      "label": "Visibility: Grid Opacity",
      "default": 0.25,
      "visible": true,
      "description": "Opacity of the triangulated spring-edge subcomponent.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      "units": "normalized"
    },
    {
      "id": "colorR",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Base Red",
      "default": 0.08,
      "visible": true,
      "description": "Normalized base red component of the model-derived palette.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "colorG",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Base Green",
      "default": 0.04,
      "visible": true,
      "description": "Normalized base green component of the model-derived palette.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "colorB",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Base Blue",
      "default": 0.22,
      "visible": true,
      "description": "Normalized base blue component of the model-derived palette.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "highlightR",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Highlight Red",
      "default": 0.95,
      "visible": true,
      "description": "Normalized highlight red component of the model-derived palette.",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "id": "highlightG",
      "kind": "float",
      "groupId": "color",
      "label": "Color: Highlight Green",
